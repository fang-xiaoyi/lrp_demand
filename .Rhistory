# -----------------------------------------------------------------------------
# ROOT: set this once to your local Box path
# -----------------------------------------------------------------------------
ROOT <- "~/Box/LRP_demand/analysis"   # Mac/Linux
# Expand ~ to full path
ROOT <- path.expand(ROOT)
# -----------------------------------------------------------------------------
# DATA paths
# -----------------------------------------------------------------------------
DIR_DATA        <- file.path(ROOT, "data")
# Raw data subfolders
DIR_RAW         <- file.path(DIR_DATA, "raw")
DIR_RAW_LRP     <- file.path(DIR_RAW,  "lrp_annual")   # lrp_2005.csv ... lrp_2026.csv
DIR_RAW_FUTURES <- file.path(DIR_RAW,  "futures")       # GF.csv, LE.csv
DIR_RAW_GAP     <- file.path(DIR_RAW,  "gap")           # ZF_indemn_amt.xlsx, OK_indemn_amt.xlsx
DIR_RAW_PANEL   <- file.path(DIR_RAW)                   # feeder_cattle.csv, fed_cattle.csv, matched_*.csv
# External data subfolders (to be downloaded)
DIR_EXT         <- file.path(DIR_DATA, "external")
DIR_DROUGHT     <- file.path(DIR_EXT,  "drought")       # USDM county-weekly
DIR_CASH        <- file.path(DIR_EXT,  "cash_price")    # USDA AMS 5-area cash price
DIR_COT         <- file.path(DIR_EXT,  "cot")           # CFTC disaggregated COT
# Processed data (generated by 01_build scripts)
DIR_PROCESSED   <- file.path(DIR_DATA, "processed")
# -----------------------------------------------------------------------------
# CODE paths
# -----------------------------------------------------------------------------
DIR_CODES       <- file.path(ROOT, "codes")
DIR_BUILD       <- file.path(DIR_CODES, "01_build")
DIR_ANALYSIS    <- file.path(DIR_CODES, "02_analysis")
DIR_FIGURES     <- file.path(DIR_CODES, "03_figures")
# -----------------------------------------------------------------------------
# RESULTS paths
# -----------------------------------------------------------------------------
DIR_RESULTS     <- file.path(ROOT, "results")
DIR_TABLES      <- file.path(DIR_RESULTS, "tables")
DIR_TAB_MAIN    <- file.path(DIR_TABLES,  "main")       # main text tables
DIR_TAB_APP     <- file.path(DIR_TABLES,  "appendix")   # appendix tables
DIR_FIGS        <- file.path(DIR_RESULTS, "figures")
DIR_FIG_MAIN    <- file.path(DIR_FIGS,    "main")       # main text figures
DIR_FIG_APP     <- file.path(DIR_FIGS,    "appendix")   # appendix figures
DIR_LOGS        <- file.path(DIR_RESULTS, "logs")
# Raw data files
FILE_FEEDER         <- file.path(DIR_RAW_PANEL, "feeder_cattle.csv")
FILE_FED            <- file.path(DIR_RAW_PANEL, "fed_cattle.csv")
FILE_MATCHED_5      <- file.path(DIR_RAW_PANEL, "matched_5.csv")
FILE_MATCHED_IV     <- file.path(DIR_RAW_PANEL, "matched_with_iv.csv")
FILE_MATCHED_FUTURE <- file.path(DIR_RAW_PANEL, "11_5_22to25_matched_futures.csv")
